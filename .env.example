# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
#   cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- database --------------------------------------------------------------
# SQLite (default, WAL enabled)
#   容器部署:      sqlite:////data/tile_remnant.db          （/data 是命名卷）
#   宿主机 systemd: sqlite:////var/lib/tile/tile_remnant.db （四条斜杠 + 绝对路径，别照抄容器路径）
#   systemd 的 EnvironmentFile 不解析引号，这里的值不要加引号
DATABASE_URL=sqlite:////data/tile_remnant.db
# PostgreSQL alternative (docker compose --profile postgres up -d):
# DATABASE_URL=postgresql+psycopg://tile:CHANGE_ME@db:5432/tile
# POSTGRES_DB=tile
# POSTGRES_USER=tile
# POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

DATA_DIR=/data
SQLITE_BUSY_TIMEOUT_MS=30000

# --- public address --------------------------------------------------------
# Must be the HTTPS origin the phones will talk to; it is embedded in the
# invite QR payload, so a wrong value breaks scanning.
PUBLIC_BASE_URL=https://tiles.example.com
API_PREFIX=/api

# --- security --------------------------------------------------------------
# Cost factor for bcrypt device-secret hashing (10-14). 12 ≈ 250 ms/hash.
BCRYPT_ROUNDS=12
# 0 = project access tokens never expire (recommended for a no-login app)
TOKEN_TTL_DAYS=0
INVITE_CODE_LENGTH=10
# Comma separated list, or * for any origin (the Android app ignores CORS)
CORS_ORIGINS=*
TRUST_PROXY_HEADERS=true

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_WRITE_PER_MINUTE=60

# --- domain ---------------------------------------------------------------
MIN_USABLE_MM=50
MAX_DIMENSION_MM=100000
MAX_QUANTITY=20000

# --- bootstrap -------------------------------------------------------------
# true  = create tables on startup (dev only)
# false = expect `alembic upgrade head` (production / docker entrypoint)
AUTO_CREATE_TABLES=false
